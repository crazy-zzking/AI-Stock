{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "MySQL": "Server=localhost;Port=3306;Database=aistock;User=root;Password=your_password;CharSet=utf8mb4;",
    "Redis": "" // 情报采集（事件引擎发布消息总线）需要；留空则情报采集无法入库
  },
  "DataProviders": {
    "Sanhu": {
      "BaseUrl": "http://www.sanhulianghua.com:2008",
      "Token": "your_token_here"
    }
  },
  "Tdx": {
    "Host": "122.51.120.217",
    "Port": 7709
  },
  "DataSync": {
    "Enabled": true, // 是否启用数据同步；false 则 Worker 空转
    "SyncHour": 15, // 收盘同步时刻（24制）；A股15:00收盘，此刻后当日才算"已收盘"可同步。勿改大于15，否则收盘后1小时内目标交易日会落后一天（GetLastClosedTradingDayAsync）
    "SyncKlines": true, // 是否同步 K 线；false 则只同步股票池
    "KlineCount": 120, // 每只股票请求的日 K 条数
    "MaxStocks": 0, // 每轮最多同步多少只股票的 K 线；0 = 全部
    "KlineThrottleMs": 200, // 每只 K 线请求间隔（毫秒）；仅当 KlineBatchSize<=1（串行）时生效
    "KlineBatchSize": 8, // K 线同步批大小（批内并发拉取）；>1 分批并行，=1 退化串行
    "KlineBatchDelayMs": 100, // K 线同步批间延迟（毫秒），避免被东财限流/封 IP
    "StockCodesUrl": "http://115.29.178.22:8080/api/codes", // 股票池接口地址（返回全市场代码）
    "WorkdayUrl": "http://115.29.178.22:8080/api/workday/range", // 交易日接口（判断收盘后是否需同步）
    "SyncDetails": true, // 是否同步股票明细（行业←东财F10 / 概念←同花顺）
    "DetailMaxStocks": 0, // 明细同步本轮最多处理多少只；0 = 全部
    "DetailBatchSize": 10, // 明细同步批大小（批内并发）
    "DetailBatchDelayMs": 50 // 明细同步批间延迟（毫秒）
  },
  "IntelligenceSync": {
    "Enabled": true, // 是否启用情报采集
    "RunOnStartup": true, // 启动后延迟 8 秒立即跑一次
    "IntervalMinutes": 60, // 采集周期（分钟）
    "CollectNews": true, // 是否采集财经新闻（getNewsByColumns，真新闻）
    "NewsCount": 20, // 每轮采集新闻条数
    "CollectAnnouncements": true, // 是否采集上市公司公告
    "AnnouncementCount": 50, // 每轮采集公告条数
    // AnnouncementKeywords 留空用代码默认（利好/利空字眼）；仅标题命中才送 LLM 分析，省 token
    "CollectReports": true, // 是否采集研报（东财 reportapi，HttpClient）
    "ReportCount": 100, // 每轮采集研报条数
    "ItemThrottleMs": 500 // 每条情报 LLM 抽取之间的间隔（毫秒）
  },
  // 每个后台任务的独立调度（启停/周期/定点）。DailyAtHour 优先于 IntervalSeconds。
  // 业务参数仍在上面 DataSync / IntelligenceSync 中（这里只管"何时跑/是否跑"）。
  "Jobs": {
    "stock-base": {
      "Enabled": true,
      "RunOnStartup": false,
      "DailyAtHour": 8
    },
    "stock-detail": {
      "Enabled": true,
      "RunOnStartup": false,
      "DailyAtHour": 8
    },
    "kline": {
      "Enabled": true,
      "RunOnStartup": true,
      "DailyAtHour": 16
    },
    "news": {
      "Enabled": true,
      "RunOnStartup": true,
      "IntervalSeconds": 1800
    },
    "announcement": {
      "Enabled": true,
      "RunOnStartup": true,
      "IntervalSeconds": 1800
    },
    "report": {
      "Enabled": true,
      "RunOnStartup": true,
      "IntervalSeconds": 3600
    },
    "knowledge-star": {
      "Enabled": true,
      "RunOnStartup": true,
      "IntervalSeconds": 300 // 5分钟高频拉取：走官方 zsxq-cli + 按发布时间增量过滤，不会重复花 LLM
    },
    "graph-promote": {
      "Enabled": true,
      "RunOnStartup": true,
      "DailyAtHour": 18
    },
    "position-cache": {
      "Enabled": false,
      "RunOnStartup": false,
      "IntervalSeconds": 30
    },
    "market-snapshot": {
      "Enabled": true,
      "RunOnStartup": true,
      "DailyAtHour": 17
    },
    "dragon-tiger": {
      "Enabled": true,
      "RunOnStartup": false,
      "DailyAtHour": 17
    },
    // 指数日K同步：启动即回补历史指数（供回放回测构造历史大盘环境），之后每日收盘后更新
    "index-kline": {
      "Enabled": true,
      "RunOnStartup": true,
      "DailyAtHour": 15
    },
    // 资金流历史同步：全市场逐股拉东财历史资金流落库（供回放回测补资金面）。首次回补较重，按需开启
    "capital-flow": {
      "Enabled": true,
      "RunOnStartup": true,
      "DailyAtHour": 16
    },
    // 概念炒作点蒸馏：LLM 把 selected_reason 提炼成短语写入 concept_digest（幂等只补空）。首次全量较重(~3.5万条)
    "concept-digest": {
      "Enabled": true,
      "RunOnStartup": true,
      "DailyAtHour": 7
    },
    // 每日全策略选股留痕：交易日 14:50（尾盘快照刷新后）所有策略各跑一遍落库，只留痕不下单
    "selection-daily": {
      "Enabled": true,
      "RunOnStartup": false,
      "DailyAtHour": 14,
      "DailyAtMinute": 50
    },
    // 开盘前选股：交易日 09:00 基于昨日完整收盘数据+隔夜情报再选一轮，供竞价/开盘埋伏
    "selection-premarket": {
      "Enabled": true,
      "RunOnStartup": false,
      "DailyAtHour": 9,
      "DailyAtMinute": 0
    },
    // 选股信号前向绩效：收盘后（日K同步之后）物化当日各策略信号并补算 T+1/3/5 收益与沪深300超额（幂等）
    "selection-performance": {
      "Enabled": true,
      "RunOnStartup": true,
      "DailyAtHour": 17
    }
  },
  // 告警/推送：配置企微或钉钉群机器人 Webhook 后，任务失败告警与每日选股报告会推送到群；留空仅写日志
  "Monitor": {
    "WebhookUrl": ""
  },
  // 候选边晋升阈值：被≥MinMentions篇情报印证且可信度≥MinCredibility 才转入权威图谱
  "GraphPromotion": {
    "MinMentions": 3,
    "MinCredibility": 70,
    "MaxPerRun": 200
  },
  // 知识星球：被高频抓取会封号，默认禁用。配好 groups 后再开，且保持低频。
  "KnowledgeStar": {
    "UseCli": false, // 推荐 true：走官方 zsxq-cli（OAuth 密钥，绕开签名/401）。需宿主装 zsxq-cli 并 auth login 一次
    "CliPath": "zsxq-cli", // zsxq-cli 可执行名/路径
    "CliTimeoutSeconds": 30,
    "AccessToken": "", // 仅 UseCli=false：浏览器登录 zsxq 后从 cookie 复制 zsxq_access_token
    "GroupIds": [], // 要采集的星球 group_id
    "Count": 20,
    "LookbackHours": 24, // 增量回看窗口：首跑/库中无星球事件时只处理最近这么多小时内的主题
    "MinDelayMs": 3000, // 每次请求前随机延迟下限（防封）
    "MaxDelayMs": 8000 // 上限
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
